# Backend
PORT=3000
WEBAPP_ORIGIN=http://localhost:5173
# Runtime connection: use a dedicated non-superuser role (see DEPLOYMENT.md),
# never the Supabase dashboard/admin role. Migrations use separate MIGRATION_DATABASE_URL.
DATABASE_URL=postgresql://agromarket_runtime:[RUNTIME-PASSWORD]@aws-0-your-region.pooler.supabase.com:5432/postgres
# Separate local/staging database URL used only by the development seed command.
DEV_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Keep disabled in production for immediate token revocation; read-through is an explicit trade-off.
AUTH_CACHE_MODE=disabled
JWT_SECRET=replace-with-local-secret
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
# Секрет вебхука бота (1-256 символов A-Za-z0-9_-) — генерировать CSPRNG (`openssl rand -hex 32`),
# НЕ придумывать вручную: /telegram/webhook не ограничен по частоте запросов, вся защита от
# перебора держится на энтропии этой строки. Передаётся в setWebhook, проверяется на каждом
# апдейте (Этап 8).
TELEGRAM_WEBHOOK_SECRET=replace-with-random-webhook-secret
# Username бота без @ (тот же бот, что VITE_TELEGRAM_BOT_USERNAME) и shortname
# Mini App из /newapp BotFather — для t.me deep-link-кнопок в уведомлениях.
TELEGRAM_BOT_USERNAME=replace_with_bot_username
TELEGRAM_MINIAPP_SHORTNAME=replace_with_miniapp_shortname
# Список реальных числовых Telegram id администраторов через запятую.
# E2E использует отдельный ADMIN_ALLOWLIST из .env.e2e.
ADMIN_ALLOWLIST=telegram_user_id

# Supabase
SUPABASE_URL=https://replace-with-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=card-images

# Cloudflare deploy
CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account-id
CLOUDFLARE_PROJECT_NAME=agromarketkz-webapp
CLOUDFLARE_WORKER_NAME=agromarketkz-backend

# Webapp
VITE_API_URL=http://localhost:3000
# Username тестового бота (без @) — для Telegram Login Widget в браузере (Этап 3).
VITE_TELEGRAM_BOT_USERNAME=replace_with_bot_username
