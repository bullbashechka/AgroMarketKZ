# Backend
PORT=3000
WEBAPP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-your-region.pooler.supabase.com:6543/postgres
JWT_SECRET=replace-with-local-secret
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
# Секрет вебхука бота (любая случайная строка 1-256 символов A-Za-z0-9_-);
# передаётся в setWebhook и проверяется на каждом апдейте (Этап 8).
TELEGRAM_WEBHOOK_SECRET=replace-with-random-webhook-secret
# Username бота без @ (тот же бот, что VITE_TELEGRAM_BOT_USERNAME) и shortname
# Mini App из /newapp BotFather — для t.me deep-link-кнопок в уведомлениях.
TELEGRAM_BOT_USERNAME=replace_with_bot_username
TELEGRAM_MINIAPP_SHORTNAME=replace_with_miniapp_shortname
# Список через запятую (без пробелов), может включать несколько id — например, тестовый id для E2E
# (см. .env.e2e.example — E2E_TEST_ADMIN_TG_ID должен присутствовать в этом списке).
ADMIN_ALLOWLIST=telegram_user_id,900000002

# Supabase
SUPABASE_URL=https://replace-with-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=card-images

# Cloudflare deploy
CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account-id
CLOUDFLARE_PROJECT_NAME=agromarketkz-webapp
CLOUDFLARE_WORKER_NAME=agromarketkz-backend

# Webapp
VITE_API_URL=http://localhost:3000
# Username тестового бота (без @) — для Telegram Login Widget в браузере (Этап 3).
VITE_TELEGRAM_BOT_USERNAME=replace_with_bot_username

