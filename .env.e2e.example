# E2E (Playwright) — отдельная тестовая база, Storage и Telegram secret.
# Не копируйте сюда значения из корневого .env: Playwright специально не загружает
# production-конфигурацию и остановится до старта серверов, если окружение небезопасно.
E2E_API_URL=http://127.0.0.1:3000
E2E_BASE_URL=http://127.0.0.1:5173
E2E_DATABASE_URL=postgresql://postgres:test-password@127.0.0.1:55432/agromarketkz_e2e
E2E_SUPABASE_URL=https://your-e2e-project.supabase.co
E2E_SUPABASE_STORAGE_BUCKET=card-images-e2e
E2E_SUPABASE_SERVICE_ROLE_KEY=replace-with-e2e-only-service-role-key
E2E_TELEGRAM_BOT_TOKEN=replace-with-e2e-only-bot-token
E2E_JWT_SECRET=replace-with-e2e-only-jwt-secret

# Telegram id и ADMIN_ALLOWLIST генерируются отдельно для каждого E2E_RUN_ID,
# чтобы параллельные прогоны не делили одну строку users.
