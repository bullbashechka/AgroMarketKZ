# E2E (Playwright) — тестовые Telegram id, для которых Playwright локально подписывает
# initData тем же TELEGRAM_BOT_TOKEN (см. e2e/helpers/telegramAuth.ts). E2E_TEST_ADMIN_TG_ID
# должен присутствовать в ADMIN_ALLOWLIST ниже.
E2E_TEST_USER_TG_ID=999000000001
E2E_TEST_ADMIN_TG_ID=999000000002
ADMIN_ALLOWLIST=999000000002
