# Stable, non-secret fixture for `wrangler types`. Keep only production-required
# secret names here; optional/local-only variables must stay out so generated
# Worker bindings preserve their optionality in AppEnv.
PAGES_PROXY_SECRET=type-generation-placeholder
ADMIN_OWNER_TELEGRAM_ID=0
TELEGRAM_BOT_TOKEN=type-generation-placeholder
TELEGRAM_WEBHOOK_SECRET=type-generation-placeholder
ADMIN_ALLOWLIST=0
SUPABASE_SERVICE_ROLE_KEY=type-generation-placeholder
