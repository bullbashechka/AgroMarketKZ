{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../.env --watch src/index.ts",
    "dev:worker": "wrangler dev",
    "build": "bun build ./src/index.ts --target bun --outdir ./dist && wrangler deploy --dry-run --outdir ./dist-worker",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "webhook:set": "bun --env-file=../.env scripts/set-webhook.ts"
  },
  "dependencies": {
    "@agromarket/contracts": "workspace:*",
    "hono": "latest",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "wrangler": "latest"
  }
}
